# Settings for running Sentinel on your own computer.
#
# To use it: copy this file, name the copy ".env" (nothing before the dot),
# and fill in the copy. The ".env" file is listed in .gitignore, so it is
# never uploaded to GitHub. Never put a real key in this example file.

# Your Claude API key, from https://console.anthropic.com (it starts "sk-ant-").
# Leave it empty to run in demo mode: stored AI answers, no cost, no key needed.
ANTHROPIC_API_KEY=

# Set to 1 to force demo mode even when a key is present.
SENTINEL_DEMO=

# Which Claude model writes the triage in live mode.
SENTINEL_MODEL=claude-opus-5-5
